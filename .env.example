VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Integration tests only (never expose to the browser or Vercel frontend env)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Edge Function secrets (supabase secrets set) — not Vite vars:
# GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET
# GMAIL_TOKEN_KEY          # long random string; encrypts the refresh token and signs OAuth state
# APP_ORIGIN               # https://your-production-host  (localhost is allowed without this)
# REACH_JWT_SECRET         # project legacy JWT secret (Settings → JWT Keys). Set with: npx supabase secrets set REACH_JWT_SECRET=...
# Google OAuth redirect URI: {APP_ORIGIN}/import/gmail/callback
#   and http://localhost:5173/import/gmail/callback for local dev
